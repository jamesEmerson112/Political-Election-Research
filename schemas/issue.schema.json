{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jamesemerson112.github.io/Political-Election-Research/schemas/issue.schema.json",
  "title": "Issue",
  "description": "An issue area and its neutrally worded questions. Editorial, so no citations. Questions are phrased so support/oppose is unambiguous; rejected questions are logged for transparency. Path: data/issues/<id>.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "questions", "rejected_questions"],
  "properties": {
    "$schema": { "$ref": "defs.schema.json#/$defs/SchemaPointer" },
    "id": { "$ref": "defs.schema.json#/$defs/Slug" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "support_means", "oppose_means", "added"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/$defs/Slug" },
          "text": { "type": "string", "minLength": 1 },
          "support_means": { "type": "string", "minLength": 1 },
          "oppose_means": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" },
          "added": { "$ref": "defs.schema.json#/$defs/Date" }
        }
      }
    },
    "rejected_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "reason", "date"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "date": { "$ref": "defs.schema.json#/$defs/Date" }
        }
      }
    }
  }
}
