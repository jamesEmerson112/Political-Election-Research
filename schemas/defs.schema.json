{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jamesemerson112.github.io/Political-Election-Research/schemas/defs.schema.json",
  "title": "Shared definitions",
  "description": "Building blocks shared by every record type. References between records are typed, prefixed strings (person:, org:, contest:, election:, q:, src:) so the schema can check what kind of thing each end of a relationship is.",
  "$defs": {
    "Slug": {
      "description": "Lowercase kebab-case identifier. Produced deterministically by `npm run id -- slug \"<name>\"`.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "Date": {
      "description": "Calendar date, YYYY-MM-DD.",
      "type": "string",
      "format": "date"
    },
    "Cycle": {
      "description": "Election cycle year the record belongs to (e.g. 2026).",
      "type": "integer",
      "minimum": 1990,
      "maximum": 2100
    },
    "SchemaPointer": {
      "description": "Relative path to this file's schema, for editor autocomplete. Set automatically by `npm run fmt` and `npm run put`.",
      "type": "string"
    },
    "PersonRef": {
      "type": "string",
      "pattern": "^person:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "OrgRef": {
      "type": "string",
      "pattern": "^org:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "ActorRef": {
      "description": "A person or an organization.",
      "type": "string",
      "pattern": "^(?:person|org):[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "ElectionRef": {
      "type": "string",
      "pattern": "^election:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "ContestRef": {
      "description": "contest:<election-slug>/<contest-slug>",
      "type": "string",
      "pattern": "^contest:[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "QuestionRef": {
      "description": "q:<issue-slug>/<question-slug>",
      "type": "string",
      "pattern": "^q:[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "SourceRef": {
      "type": "string",
      "pattern": "^src:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "PersonOrContestRef": {
      "type": "string",
      "pattern": "^(?:person:[a-z0-9]+(?:-[a-z0-9]+)*|contest:[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*)$"
    },
    "BillRef": {
      "description": "ca-<session start year>-<ab|sb|...>-<n>, us-<congress>-<hr|s|...>-<n>, or a local legislative file: <place>-file-<number> (e.g. sf-file-251080 for San Francisco Board of Supervisors File No. 251080).",
      "type": "string",
      "pattern": "^(?:ca-[0-9]{4}-(?:ab|sb|aca|sca|acr|scr|ajr|sjr|hr|sr)-[0-9]+|us-[0-9]{1,3}-(?:hr|s|hjres|sjres|hconres|sconres|hres|sres)-[0-9]+|[a-z]{2,6}-file-[0-9][0-9a-z-]*)$"
    },
    "Citation": {
      "description": "Points at a source. `quote` must be copied verbatim from the source (required for every non-filing source). When the source could not be opened by the recording agent but a maintainer reviewed it, `verified_by` records who and when, and the quote is pending: `validate` warns [QUOTE_PENDING] and `validate --strict` (the release gate) fails until the quote is filled in. `locator` pins the spot: page, video timestamp, filing schedule/line/transaction.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "verified_by": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "date"
          ],
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "$ref": "#/$defs/Date"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "unverified": {
          "description": "The recording agent saw this source only indirectly (e.g. a web search summary) and nobody has verified it. validate warns [UNVERIFIED_CITATION]; --strict fails.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "method",
            "date"
          ],
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "$ref": "#/$defs/Date"
            }
          }
        }
      }
    },
    "Citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Citation"
      }
    },
    "SearchLogEntry": {
      "description": "One place we looked and found nothing. Used instead of citations when recording a research gap.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "where",
        "query",
        "date"
      ],
      "properties": {
        "where": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "$ref": "#/$defs/Date"
        }
      }
    },
    "SearchLog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/SearchLogEntry"
      }
    },
    "CitedString": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "citations"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "citations": {
          "$ref": "#/$defs/Citations"
        }
      }
    },
    "CitedDate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "citations"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/Date"
        },
        "citations": {
          "$ref": "#/$defs/Citations"
        }
      }
    },
    "NotFound": {
      "description": "A recorded research gap: we searched and found nothing. A fact about our research, not about the subject.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "as_of",
        "search_log"
      ],
      "properties": {
        "status": {
          "const": "not_found"
        },
        "as_of": {
          "$ref": "#/$defs/Date"
        },
        "search_log": {
          "$ref": "#/$defs/SearchLog"
        }
      }
    },
    "CitedStringOrNotFound": {
      "oneOf": [
        {
          "$ref": "#/$defs/CitedString"
        },
        {
          "$ref": "#/$defs/NotFound"
        }
      ]
    },
    "Period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/Date"
        },
        "end": {
          "$ref": "#/$defs/Date"
        }
      }
    },
    "OpenPeriod": {
      "description": "A period that may still be ongoing (no end).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/Date"
        },
        "end": {
          "$ref": "#/$defs/Date"
        }
      }
    },
    "Money": {
      "description": "An aggregate amount over a reporting period, in integer cents (never floats). Records are aggregates, never raw transactions.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount_cents",
        "period",
        "basis"
      ],
      "properties": {
        "amount_cents": {
          "type": "integer",
          "minimum": 0
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "basis": {
          "description": "itemized = sum of itemized lines in the cited filing(s); reported_total = a total printed in the filing; aggregated_by_project = we summed across several cited filings.",
          "enum": [
            "itemized",
            "reported_total",
            "aggregated_by_project"
          ]
        }
      }
    },
    "ElectionDesignation": {
      "description": "Which election a contribution or expenditure was designated for. Contribution limits apply per election.",
      "enum": [
        "primary",
        "general",
        "special",
        "runoff",
        "other"
      ]
    },
    "ExternalId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "id"
      ],
      "properties": {
        "system": {
          "enum": [
            "cal_access_filer",
            "cars_filer",
            "fppc",
            "fec_candidate",
            "fec_committee",
            "lda_registrant",
            "lda_client",
            "ca_lobbyist_employer",
            "wikidata",
            "ballotpedia",
            "other"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ExternalIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExternalId"
      }
    },
    "Links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "campaign_site": {
          "type": "string",
          "format": "uri"
        },
        "official_site": {
          "type": "string",
          "format": "uri"
        },
        "wikipedia": {
          "type": "string",
          "format": "uri"
        },
        "ballotpedia": {
          "type": "string",
          "format": "uri"
        },
        "x": {
          "type": "string",
          "format": "uri"
        },
        "facebook": {
          "type": "string",
          "format": "uri"
        },
        "instagram": {
          "type": "string",
          "format": "uri"
        },
        "youtube": {
          "type": "string",
          "format": "uri"
        },
        "civlab": {
          "description": "Node page on the CivLab government graph, e.g. https://graph.civlab.org/sf/elected/ccsf-board-of-supervisors",
          "type": "string",
          "format": "uri",
          "pattern": "^https://graph\\.civlab\\.org/"
        }
      }
    },
    "PartialDate": {
      "description": "YYYY, YYYY-MM or YYYY-MM-DD, as precise as the source states.",
      "type": "string",
      "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$"
    },
    "CitedPartialDate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "citations"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/PartialDate"
        },
        "citations": {
          "$ref": "#/$defs/Citations"
        }
      }
    },
    "CitedPartialDateOrNotFound": {
      "oneOf": [
        {
          "$ref": "#/$defs/CitedPartialDate"
        },
        {
          "$ref": "#/$defs/NotFound"
        }
      ]
    },
    "CitedSummary": {
      "description": "A neutral one-to-three sentence summary with its citations.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "citations"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "date": {
          "$ref": "#/$defs/PartialDate"
        },
        "citations": {
          "$ref": "#/$defs/Citations"
        }
      }
    },
    "OfficeRef": {
      "type": "string",
      "pattern": "^office:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "CitedNumber": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "citations"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "as_of": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "citations": {
          "$ref": "#/$defs/Citations"
        }
      }
    }
  }
}
